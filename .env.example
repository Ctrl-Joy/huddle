# Copy to .env (repo root or apps/server/) for local dev; the server loads it on start.
# In production, set these as real environment variables instead.

# GIF picker: a GIPHY API key from developers.giphy.com (leave empty to hide the GIF button)
HUDDLE_GIF_API_KEY=

# TURN relay for calls across strict NATs (comma-separated urls), served to clients at /api/ice
HUDDLE_TURN_URL=
HUDDLE_TURN_USERNAME=
HUDDLE_TURN_CREDENTIAL=

# Login token signing key (otherwise generated into the data directory on first boot)
HUDDLE_JWT_SECRET=
