# Copy to .env (repo root or apps/server/) for local dev; the server loads it on start.
# In production, set these as real environment variables instead.

# GIF picker: a GIPHY API key from developers.giphy.com (leave empty to hide the GIF button)
HUDDLE_GIF_API_KEY=

# TURN relay for calls across strict NATs (comma-separated urls), served to clients at /api/ice
HUDDLE_TURN_URL=
# Shared with coturn's static-auth-secret; preferred over a fixed username/credential.
HUDDLE_TURN_SECRET=
HUDDLE_TURN_USERNAME=
HUDDLE_TURN_CREDENTIAL=

# Login token signing key (otherwise generated into the data directory on first boot)
HUDDLE_JWT_SECRET=

# Email (verification at sign-up, password reset, email change). Setting HUDDLE_SMTP_HOST turns verification on.
# Brevo: smtp-relay.brevo.com / 587. Gmail: smtp.gmail.com / 465 with an app password. Port 465 = TLS, 587 = STARTTLS.
HUDDLE_SMTP_HOST=
HUDDLE_SMTP_PORT=
HUDDLE_SMTP_USER=
HUDDLE_SMTP_PASS=
# Sender shown in the inbox, e.g. Huddle <no-reply@huddlechat.duckdns.org>
HUDDLE_MAIL_FROM=
# Site address used in email links, e.g. https://huddlechat.duckdns.org
HUDDLE_PUBLIC_URL=
# Dev only: 1 = require verification without SMTP; codes are printed to the server console
HUDDLE_REQUIRE_EMAIL_VERIFICATION=
