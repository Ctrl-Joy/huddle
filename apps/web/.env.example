# Optional TURN relay for voice/video (WebRTC). STUN (stun.l.google.com:19302) is always used.
# Without TURN, calls between peers behind symmetric NATs / strict firewalls may fail to connect.
# Multiple URLs may be comma-separated, e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
